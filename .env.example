# w.Lighter Django backend — environment variables
# 실제 값은 .env 파일에 채워 넣으세요(.env는 git에 올리지 마세요).
# 이 파일은 어떤 키가 필요한지 보여주는 템플릿입니다.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=True
# 쉼표로 구분 (운영 시 실제 도메인): example.com,www.example.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# 운영(HTTPS) 도메인. 쉼표 구분. 예: https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- OAuth (django-allauth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Toss Payments ---
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_SUCCESS_URL=http://127.0.0.1:8000/credits/success/
TOSS_FAIL_URL=http://127.0.0.1:8000/credits/fail/

# --- OpenAI (characters/covers/relationships AI 기능) ---
OPENAI_API_KEY=

# --- FastAPI 번역/현지화 서비스 (translation/guides 앱이 호출) ---
# 모델링 작업_통합 초안/api_server.py 등으로 띄운 서비스의 base URL
WLIGHTER_API_BASE=http://127.0.0.1:8001
